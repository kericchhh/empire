{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario",
  "type": "object",
  "properties": {
    "calendar": {
      "$ref": "#/$defs/Calendar"
    },
    "contacts": {
      "description": "Pairs of empires that know each other at the start. Empires in no pair have never met:\nneither knows the other exists until an event introduces them.",
      "type": "array",
      "default": [],
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/EmpireId"
        },
        "maxItems": 2,
        "minItems": 2
      }
    },
    "description": {
      "description": "The situation at the start, known to every seat.",
      "type": "string",
      "default": ""
    },
    "empires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EmpireDef"
      }
    },
    "game_master": {
      "description": "A seat that sees everything and rules on free-form actions.",
      "anyOf": [
        {
          "$ref": "#/$defs/GameMasterDef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "type": "string"
    },
    "theme": {
      "$ref": "#/$defs/Theme",
      "default": {
        "font_body": null,
        "font_display": null,
        "palette": [],
        "terms": {}
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "calendar",
    "empires"
  ],
  "$defs": {
    "Calendar": {
      "type": "object",
      "properties": {
        "negative_suffix": {
          "description": "Suffix for years below zero, e.g. \"BC\". Without it, negative years print as-is.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "periods": {
          "description": "One name per tick in a year, e.g. the four seasons.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "positive_suffix": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "start_year": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_year",
        "periods"
      ]
    },
    "CharacterDef": {
      "type": "object",
      "properties": {
        "goals": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "id": {
          "$ref": "#/$defs/CharacterId"
        },
        "name": {
          "type": "string"
        },
        "office": {
          "description": "The ruleset office the character starts in. It decides what they can do and see.",
          "$ref": "#/$defs/OfficeId"
        },
        "persona": {
          "type": "string",
          "default": ""
        },
        "region": {
          "description": "Home region. Must belong to the character's empire.",
          "type": "string"
        },
        "secrets": {
          "description": "Known only to this character's seat and the game master.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "start": {
          "description": "Optional starting values for the ruleset's resources. Unset ones are generated.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          },
          "default": {}
        },
        "title": {
          "description": "How the setting names this character's position, e.g. \"Princeps\" or \"Poet\".",
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "office",
        "region"
      ]
    },
    "CharacterId": {
      "description": "A named individual, or a population group voiced as one, played by a seat.",
      "type": "string"
    },
    "EmpireDef": {
      "type": "object",
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterDef"
          }
        },
        "culture": {
          "description": "Free-form facts this empire's people live by: religion, ideology, lifestyle, values.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "description": {
          "description": "Known to every seat.",
          "type": "string",
          "default": ""
        },
        "id": {
          "$ref": "#/$defs/EmpireId"
        },
        "name": {
          "type": "string"
        },
        "regions": {
          "description": "The territory the empire starts with.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RegionDef"
          }
        },
        "seats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeatDef"
          }
        },
        "start": {
          "description": "Optional starting values for the ruleset's empire metrics. Unset ones are generated.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "regions",
        "characters",
        "seats"
      ]
    },
    "EmpireId": {
      "description": "A power on the map with its own territory, numbers and people.",
      "type": "string"
    },
    "GameMasterDef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/SeatId"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "OfficeId": {
      "description": "A position of power defined by the ruleset, such as head of state. It decides which\nactions a character may take and which numbers they see.",
      "type": "string"
    },
    "RegionDef": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "default": ""
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "start": {
          "description": "Optional starting values for the ruleset's region stats. Unset ones are generated.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "SeatDef": {
      "type": "object",
      "properties": {
        "controls": {
          "description": "Characters of this seat's empire that it plays.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterId"
          }
        },
        "id": {
          "$ref": "#/$defs/SeatId"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "controls"
      ]
    },
    "SeatId": {
      "description": "A slot that one external agent or human claims with a token.",
      "type": "string"
    },
    "Theme": {
      "description": "Presentation hints the UI applies as CSS variables and vocabulary.",
      "type": "object",
      "properties": {
        "font_body": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "font_display": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "palette": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "terms": {
          "description": "Setting vocabulary, e.g. currency -> denarii, head_of_state -> Princeps.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    }
  }
}
