#!/usr/bin/env bash
set -euo pipefail
umask 077

usage() {
  cat <<'EOF'
Usage: scripts/empire <command> [arguments]

Commands:
  start [--scenario FILE] [--seed N] [--tick-seconds N]  Start a throwaway headless world
  doctor                             Check the running world, MCP and admin API
  tool <seat> <name> <json>          Call an MCP tool as a seat
  api <METHOD> <path> [json]         Call an admin API endpoint
  tick [n]                           Force-close n ticks (default 1)
  chronicle                          Print the current chronicle
  views                              Print every seat's look view
  stop                               Stop this CLI's world and remove its state
  --help                             Show this help

Set EMPIRE_STATE_DIR on every command to choose the state directory. The
default is specific to this checkout and is removed by stop.
EOF
}

command -v curl >/dev/null 2>&1 || { echo 'scripts/empire requires curl'; exit 2; }
command -v jq >/dev/null 2>&1 || { echo 'scripts/empire requires jq'; exit 2; }
fail() { jq -cn --arg error "$1" --arg next "$2" '{error:$error,next:$next}' >&2; exit 2; }
fail_response() { jq -c --arg next "$2" 'if type == "object" then . + (if has("error") then {} else {error:"request failed"} end) + {next:$next} else {error:.,next:$next} end' <<<"${1:-{}}" >&2; exit 2; }
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
repo_key=$(printf '%s' "$root" | cksum | awk '{print $1}')
state=${EMPIRE_STATE_DIR:-${TMPDIR:-/tmp}/empire-$repo_key}
api() { printf 'http://127.0.0.1:%s' "$(cat "$state/port")"; }
admin_header() { printf 'Authorization: Bearer %s' "$(cat "$state/admin")" >"$state/admin.header"; }
mcp() {
  curl --fail-with-body -s "$(api)/mcp" -H 'content-type: application/json' \
    -H 'accept: application/json, text/event-stream' "$@"
}
call_tool() {
  local seat=$1 name=$2 args=$3 token session
  token=$(jq -er --arg seat "$seat" '.[$seat]' "$state/seats.json") || fail "unknown seat '$seat'" "Run scripts/empire views and choose one of: $(jq -r 'keys | join(", ")' "$state/seats.json")"
  session=$(mcp -D - -o /dev/null -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"empire-control","version":"1"}}}' | tr -d '\r' | sed -n 's/^mcp-session-id: //Ip') || fail "MCP did not answer" "Run scripts/empire doctor; if needed, restart with scripts/empire stop && scripts/empire start"
  [ -n "$session" ] || fail "MCP returned no session" "Run scripts/empire doctor and check the world's server log"
  mcp -H "mcp-session-id: $session" -o /dev/null -d '{"jsonrpc":"2.0","method":"notifications/initialized"}' || fail "MCP session initialization failed" "Run scripts/empire doctor and inspect '$state/log'"
  jq -nc --arg name "$name" --argjson args "$args" --arg token "$token" '{jsonrpc:"2.0",id:2,method:"tools/call",params:{name:$name,arguments:($args + {seat_token:$token})}}' >"$state/request.json"
  local response
  response=$(mcp -H "mcp-session-id: $session" -d @- <"$state/request.json") || fail_response "$response" "Run scripts/empire doctor and inspect '$state/log'"
  jq '.result.structuredContent // .result // .error' <<<"$(sed -n 's/^data: //p' <<<"$response")" || fail "MCP tool response was not valid JSON" "Run scripts/empire doctor and inspect '$state/log'"
}

cmd=${1:-}
case "$cmd" in
  --help|-h|help) usage ;;
  start)
    shift
    scenario=scenarios/rome.yaml seed=2026 tick_seconds=86400
    while (($#)); do
      case "$1" in
        --scenario) (($# >= 2)) || fail "--scenario needs a file" "Use scripts/empire start --scenario scenarios/rome.yaml"; scenario=$2; shift 2 ;;
        --seed) (($# >= 2)) || fail "--seed needs a number" "Use scripts/empire start --seed 2026"; [[ $2 =~ ^[0-9]+$ ]] || fail "seed must be a non-negative integer" "Use scripts/empire start --seed 2026"; seed=$2; shift 2 ;;
        --tick-seconds) (($# >= 2)) || fail "--tick-seconds needs a number" "Use scripts/empire start --tick-seconds 2"; [[ $2 =~ ^[1-9][0-9]*$ ]] || fail "tick duration must be a positive integer" "Use scripts/empire start --tick-seconds 2"; tick_seconds=$2; shift 2 ;;
        *) fail "unknown start option: $1" "Run scripts/empire --help" ;;
      esac
    done
    [[ -f $scenario ]] || fail "scenario file not found: $scenario" "Choose a scenario such as scenarios/rome.yaml"
    [[ ! -d $state || -z $(find "$state" -mindepth 1 -maxdepth 1 -print -quit) ]] || fail "state directory already exists: $state" "another world uses this dir; set EMPIRE_STATE_DIR to a new path"
    cargo build -q -p sim-server || fail "could not build sim-server" "Fix the cargo build error, then retry"
    if [[ ! -d $state ]]; then (umask 077; mkdir -p "$state"); fi
    scenario=$(realpath "$scenario")
    detach=(); command -v setsid >/dev/null 2>&1 && detach=(setsid) || detach=(nohup)
    "${detach[@]}" target/debug/sim-server run --db "$state/world.db" --scenario "$scenario" --seed "$seed" --bind '127.0.0.1:0' --tick-seconds "$tick_seconds" >"$state/out" 2>"$state/log" </dev/null &
    echo $! >"$state/pid"
    ready=false
    for _ in $(seq 101); do
      if grep -q 'MCP endpoint:' "$state/out" && grep -q '^Seat tokens:' "$state/out"; then endpoint=$(sed -n 's|.*MCP endpoint: http://127\.0\.0\.1:\([0-9]*\)/mcp.*|\1|p' "$state/out"); if [[ -n $endpoint ]]; then printf '%s\n' "$endpoint" >"$state/port"; curl -s -o /dev/null "$(api)/mcp" && { ready=true; break; }; fi; fi
      if ! kill -0 "$(cat "$state/pid")" 2>/dev/null; then cat "$state/log" >&2; rm -rf "$state"; fail "world failed to start" "Check cargo output and scenario, then retry scripts/empire start"; fi
      sleep 0.1
    done
    if [[ $ready != true ]]; then kill "$(cat "$state/pid")" 2>/dev/null || true; cat "$state/log" >&2; rm -rf "$state"; fail "world did not answer in 10 seconds" "Check cargo output and scenario, then retry scripts/empire start"; fi
    admin=$(sed -n 's/^Admin token (for \/api): //p' "$state/out")
    [[ -n $admin ]] || fail "world did not provide an admin token" "Check the world log and retry scripts/empire start"
    printf '%s' "$admin" >"$state/admin"
    sed -n '/^Seat tokens:/,/^$/p' "$state/out" | tail -n +2 | awk 'NF >= 2 {print $1, $2}' | jq -Rn '[inputs | split(" ") | {(.[0]):.[1]}] | add // {}' >"$state/seats.json"
    jq -cn --arg url "$(api)/mcp" --arg state "$state" --argjson seats "$(jq 'keys' "$state/seats.json")" '{status:"started",mcp:$url,state_dir:$state,seats:$seats}'
    ;;
  doctor)
    [[ -f $state/pid ]] || fail "no Empire world is recorded" "Start one with scripts/empire start"
    pid=$(cat "$state/pid")
    kill -0 "$pid" 2>/dev/null || fail "the recorded world process is not running" "Run scripts/empire stop to clear stale state, then start again"
    mcp -o /dev/null -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"doctor","version":"1"}}}' || fail "world is up but MCP did not answer" "Check '$state/log'; restart with scripts/empire stop && scripts/empire start"
    admin_header; overview=$(curl --fail-with-body -s -H @"$state/admin.header" "$(api)/api/overview") || fail_response "$overview" "Check '$state/admin'; restart with scripts/empire stop && scripts/empire start"
    jq -cn --argjson overview "$overview" '{status:"healthy",mcp:"answered",admin:"authorized",tick:$overview.state.tick}'
    ;;
  tool)
    (($# == 4)) || fail "tool needs a seat, tool name and JSON object" "Example: scripts/empire tool princeps look '{}'"
    jq -e 'type == "object"' <<<"$4" >/dev/null || fail "tool arguments must be a JSON object" "Pass '{}' or another JSON object as the fourth argument"
    [[ -f $state/seats.json ]] || fail "no Empire world is recorded" "Start one with scripts/empire start"
    call_tool "$2" "$3" "$4"
    ;;
  api)
    (($# >= 3 && $# <= 4)) || fail "api needs a method, path and optional JSON body" "Run scripts/empire --help for usage"
    [[ -f $state/admin ]] || fail "no Empire world is recorded" "Start one with scripts/empire start"
    admin_header
    if (($# == 4)); then printf '%s' "$4" >"$state/request.json"; response=$(curl --fail-with-body -s -X "$2" -H @"$state/admin.header" -H 'content-type: application/json' -d @- "$(api)$3" <"$state/request.json") || fail_response "$response" "Run scripts/empire doctor and inspect '$state/log'"; else response=$(curl --fail-with-body -s -X "$2" -H @"$state/admin.header" "$(api)$3") || fail_response "$response" "Run scripts/empire doctor and inspect '$state/log'"; fi
    printf '%s\n' "$response"
    ;;
  tick)
    n=${2:-1}; [[ $n =~ ^[1-9][0-9]*$ ]] || fail "tick count must be a positive integer" "Use scripts/empire tick 1"
    [[ -f $state/admin ]] || fail "no Empire world is recorded" "Start one with scripts/empire start"
    admin_header; : >"$state/ticks.jsonl"
    for ((i=0; i<n; i++)); do response=$(curl --fail-with-body -s -X POST -H @"$state/admin.header" "$(api)/api/tick") || fail_response "$response" "Run scripts/empire doctor and inspect '$state/log'"; printf '%s\n' "$response" >>"$state/ticks.jsonl"; done
    jq -s '{closed:map(.tick)}' "$state/ticks.jsonl" || fail "tick response was not valid JSON" "Run scripts/empire doctor and inspect '$state/log'"
    ;;
  chronicle)
    [[ -f $state/admin ]] || fail "no Empire world is recorded" "Start one with scripts/empire start"
    admin_header; response=$(curl --fail-with-body -s -H @"$state/admin.header" "$(api)/api/overview") || fail_response "$response" "Run scripts/empire doctor and inspect '$state/log'"; jq '{tick:.state.tick,date,chronicle}' <<<"$response" || fail "chronicle response was not valid JSON" "Run scripts/empire doctor and inspect '$state/log'"
    ;;
  views)
    [[ -f $state/seats.json ]] || fail "no Empire world is recorded" "Start one with scripts/empire start"
    : >"$state/views.jsonl"
    while read -r seat; do result=$(call_tool "$seat" look '{}'); jq -cn --arg seat "$seat" --argjson view "$result" '{seat:$seat,view:$view}' >>"$state/views.jsonl" || fail "view response was not valid JSON" "Run scripts/empire doctor and inspect '$state/log'"; done < <(jq -r 'keys[]' "$state/seats.json")
    jq -s . "$state/views.jsonl"
    ;;
  stop)
    [[ -f $state/pid ]] || { jq -cn '{status:"stopped",detail:"no state to clean"}'; exit 0; }
    pid=$(cat "$state/pid"); db="$state/world.db"
    if kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o command= | grep -Fq "$db"; then
      kill "$pid"
      for _ in $(seq 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
      if kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o command= | grep -Fq "$db"; then kill -KILL "$pid"; fi
    fi
    rm -rf "$state"
    jq -cn '{status:"stopped",state_removed:true}'
    ;;
  *) usage >&2; fail "unknown command: ${cmd:-<empty>}" "Run scripts/empire --help" ;;
esac
