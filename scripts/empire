#!/usr/bin/env bash
set -euo pipefail
umask 077

usage() {
  cat <<'EOF'
Usage: scripts/empire <command> [arguments]

Commands:
  start [--scenario FILE] [--seed N] [--tick-seconds N]  Start a throwaway headless world
  doctor                             Check the running world, MCP and admin API
  tool <seat> <name> <json>          Call an MCP tool as a seat
  api <METHOD> <path> [json]         Call an admin API endpoint
  tick [n]                           Force-close n ticks (default 1)
  chronicle                          Print the current chronicle
  views                              Print every seat's look view
  app --out FILE [--view TEXT]       Screenshot a copy of this world in the desktop app (Linux)
  stop                               Stop this CLI's world and remove its state
  --help                             Show this help

Output is JSON. A failure prints {"error","next"} on stderr and exits 2.
Set EMPIRE_STATE_DIR on every command to choose the state directory. The
default is specific to this checkout and is removed by stop.
EOF
}

for tool in curl jq; do
  command -v $tool >/dev/null || { printf '{"error":"scripts/empire requires %s","next":"Install %s"}\n' $tool $tool >&2; exit 2; }
done
fail() { jq -cn --arg error "$1" --arg next "$2" '{error: $error, next: $next}' >&2; exit 2; }
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
cd "$root"
state=${EMPIRE_STATE_DIR:-${TMPDIR:-/tmp}/empire-$(printf '%s' "$root" | cksum | cut -d' ' -f1)}
check="Run scripts/empire doctor and inspect '$state/log'"
init='{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"empire","version":"1"}}}'

url() { printf 'http://127.0.0.1:%s%s' "$(cat "$state/port")" "$1"; }
need() { [[ -f $state/$1 ]] || fail "no Empire world is recorded" "Start one with scripts/empire start"; }
debug() { printf '%s/debug/%s' "$(cargo metadata -q --format-version 1 --no-deps | jq -r .target_directory)" "$1"; }

# admin <METHOD> <path> [json]
admin() {
  local body=() out
  (($# == 3)) && body=(-H 'content-type: application/json' --data-binary @-)
  out=$(curl --fail-with-body -s -X "$1" -H @"$state/admin.header" ${body[@]+"${body[@]}"} "$(url "$2")" <<<"${3:-}") ||
    fail "${out:-the request failed}" "$check"
  printf '%s\n' "$out"
}

mcp() {
  curl --fail-with-body -s "$(url /mcp)" -H 'content-type: application/json' \
    -H 'accept: application/json, text/event-stream' "$@"
}

# call_tool <seat> <name> <json>: the seat token reaches jq through its environment, never an argv.
call_tool() {
  local token session out
  token=$(jq -er --arg seat "$1" '.[$seat]' "$state/seats.json") ||
    fail "unknown seat '$1'" "Choose one of: $(jq -r 'keys | join(", ")' "$state/seats.json")"
  session=$(mcp -D - -o /dev/null -d "$init" | tr -d '\r' | awk 'tolower($1) == "mcp-session-id:" {print $2}') || fail "MCP did not answer" "$check"
  [[ -n $session ]] || fail "MCP returned no session" "$check"
  mcp -H "mcp-session-id: $session" -o /dev/null -d '{"jsonrpc":"2.0","method":"notifications/initialized"}' ||
    fail "MCP session initialization failed" "$check"
  out=$(token=$token jq -nc --arg name "$2" --argjson args "$3" \
    '{jsonrpc: "2.0", id: 2, method: "tools/call", params: {name: $name, arguments: ($args + {seat_token: env.token})}}' |
    mcp -H "mcp-session-id: $session" -d @-) || fail "${out:-MCP did not answer}" "$check"
  out=$(sed -n 's/^data: //p' <<<"$out")
  [[ -n $out ]] || fail "MCP returned no result" "$check"
  jq -e 'has("error") | not' <<<"$out" >/dev/null 2>&1 ||
    fail "$(jq -c '.error' <<<"$out" 2>/dev/null || printf '%s' "$out")" "Check the tool name and arguments in .agents/skills/verify/features"
  jq '.result.structuredContent // .result' <<<"$out"
}

cmd=${1:-}
case "$cmd" in
  --help | -h | help) usage ;;
  start)
    shift
    scenario=scenarios/rome.yaml seed=2026 tick_seconds=86400
    while (($#)); do
      case "$1" in --scenario | --seed | --tick-seconds) ;; *) fail "unknown start option: $1" "Run scripts/empire --help" ;; esac
      (($# >= 2)) || fail "$1 needs a value" "Run scripts/empire --help"
      case "$1" in
        --scenario) scenario=$2 ;;
        --seed) [[ $2 =~ ^[0-9]+$ ]] || fail "--seed must be a non-negative integer" "Use --seed 2026"; seed=$2 ;;
        *) [[ $2 =~ ^[1-9][0-9]*$ ]] || fail "--tick-seconds must be a positive integer" "Use --tick-seconds 2"; tick_seconds=$2 ;;
      esac
      shift 2
    done
    [[ -f $scenario ]] || fail "scenario file not found: $scenario" "Choose a scenario such as scenarios/rome.yaml"
    [[ ! -e $state || -O $state ]] || fail "state directory belongs to another user: $state" "Set EMPIRE_STATE_DIR to a new path"
    [[ ! -d $state || -z $(ls -A "$state") ]] ||
      fail "state directory already in use: $state" "Stop that world with scripts/empire stop, or set EMPIRE_STATE_DIR to a new path"
    cargo build -q -p sim-server || fail "could not build sim-server" "Fix the cargo build error, then retry"
    mkdir -p "$state" && chmod 700 "$state"
    bin=$(debug sim-server)
    detach=(setsid); command -v setsid >/dev/null || detach=(nohup)
    "${detach[@]}" "$bin" run --db "$state/world.db" --scenario "$(realpath "$scenario")" --seed "$seed" \
      --bind 127.0.0.1:0 --tick-seconds "$tick_seconds" >"$state/out" 2>"$state/log" </dev/null &
    echo $! >"$state/pid"
    abort() {
      local log
      kill "$(cat "$state/pid")" 2>/dev/null || true
      log=$(tail -n 20 "$state/log")
      rm -rf "$state"
      fail "$1${log:+: $log}" "Fix the scenario or the build, then retry scripts/empire start"
    }
    # The seat tokens are complete once a blank line follows their heading.
    for ((i = 0; i < 100; i++)); do
      awk '/^Seat tokens:/ {s = 1} s && /^$/ {f = 1} END {exit !f}' "$state/out" 2>/dev/null && break
      kill -0 "$(cat "$state/pid")" 2>/dev/null || abort "the world failed to start"
      sleep 0.1
    done
    port=$(sed -n 's|.*MCP endpoint: http://127\.0\.0\.1:\([0-9]*\)/mcp.*|\1|p' "$state/out")
    admin=$(sed -n 's/^Admin token (for \/api): //p' "$state/out")
    [[ -n $port && -n $admin ]] || abort "the world did not start in 10 seconds"
    printf '%s\n' "$port" >"$state/port"
    printf 'Authorization: Bearer %s\n' "$admin" >"$state/admin.header"
    sed -n '/^Seat tokens:/,/^$/p' "$state/out" | awk 'NR > 1 && NF >= 2 {print $1, $2}' |
      jq -Rn '[inputs | split(" ") | {(.[0]): .[1]}] | add // {}' >"$state/seats.json"
    jq -c --arg url "$(url /mcp)" --arg state "$state" '{status: "started", mcp: $url, state_dir: $state, seats: keys}' "$state/seats.json"
    ;;
  doctor)
    need pid
    kill -0 "$(cat "$state/pid")" 2>/dev/null ||
      fail "the recorded world process is not running" "Run scripts/empire stop to clear stale state, then start again"
    mcp -o /dev/null -d "$init" || fail "the world is up but MCP did not answer" "$check"
    admin GET /api/overview | jq -c '{status: "healthy", mcp: "answered", admin: "authorized", tick: .state.tick}'
    ;;
  tool)
    (($# == 4)) || fail "tool needs a seat, a tool name and a JSON object" "Example: scripts/empire tool princeps look '{}'"
    jq -e 'type == "object"' <<<"$4" >/dev/null 2>&1 || fail "tool arguments must be a JSON object" "Pass '{}' or another JSON object"
    need seats.json
    call_tool "$2" "$3" "$4"
    ;;
  api)
    (($# == 3 || $# == 4)) || fail "api needs a method, a path and an optional JSON body" "Run scripts/empire --help"
    need admin.header
    admin "${@:2}"
    ;;
  tick)
    n=${2:-1}
    [[ $n =~ ^[1-9][0-9]*$ ]] || fail "tick count must be a positive integer" "Use scripts/empire tick 1"
    need admin.header
    closed=$(for ((i = 0; i < n; i++)); do admin POST /api/tick; done)
    jq -s '{closed: map(.tick)}' <<<"$closed"
    ;;
  chronicle)
    need admin.header
    overview=$(admin GET /api/overview)
    jq '{tick: .state.tick, date, chronicle}' <<<"$overview"
    ;;
  views)
    need seats.json
    views=$(for seat in $(jq -r 'keys[]' "$state/seats.json"); do
      call_tool "$seat" look '{}' | jq -c --arg seat "$seat" '{seat: $seat, view: .}' || exit 2
    done)
    jq -s . <<<"$views"
    ;;
  stop)
    [[ -f $state/pid ]] || { jq -cn '{status: "stopped", detail: "no state to clean"}'; exit 0; }
    pid=$(cat "$state/pid")
    ours() { kill -0 "$pid" 2>/dev/null && [[ $(ps -p "$pid" -o command=) == *"$state/world.db"* ]]; }
    if ours; then
      kill "$pid"
      for _ in $(seq 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
      if ours; then kill -KILL "$pid"; fi
    fi
    rm -rf "$state"
    jq -cn '{status: "stopped", state_removed: true}'
    ;;
  app)
    shift
    view="Whole world" out=
    while (($#)); do
      case "$1" in --view | --out) ;; *) fail "unknown app option: $1" "Run scripts/empire --help" ;; esac
      (($# >= 2)) || fail "$1 needs a value" "Run scripts/empire --help"
      if [[ $1 == --view ]]; then view=$2; else out=$2; fi
      shift 2
    done
    [[ -n $out ]] || fail "app needs --out FILE" "Example: scripts/empire app --view 'Seen by The Senate' --out \"\$evidence/senate.png\""
    [[ $(uname) == Linux ]] ||
      fail "the desktop app can be driven on Linux only: tauri-driver has no macOS WebDriver" "Run on Linux, or ask the user to look at the app"
    need pid
    require() { command -v "$1" >/dev/null || fail "scripts/empire app requires $1" "$2"; }
    require WebKitWebDriver "Install it: sudo pacman -S webkitgtk-6.0 on Arch, sudo apt install webkit2gtk-driver on Debian or Ubuntu"
    require tauri-driver "cargo install --locked tauri-driver --version 2.1.0, and put ~/.cargo/bin on PATH"
    require weston "Install weston, which gives the app a headless display"
    require pnpm "Install pnpm, then run pnpm --dir app install"
    [[ -n ${XDG_RUNTIME_DIR:-} ]] || fail "XDG_RUNTIME_DIR is not set" "Run from a normal login session"
    app=$state/app
    rm -rf "$app"
    mkdir -p "$app/data/dev.empire.app/worlds"
    pnpm --dir app tauri build --debug --no-bundle >"$app/build.log" 2>&1 ||
      fail "could not build the desktop app" "Read $app/build.log"
    bin=$(debug empire-app)
    # The app gets its own data directory: a copy of this world, and no agent login, so the rules play every seat.
    for f in "$state"/world.db*; do cp "$f" "$app/data/dev.empire.app/worlds/verify${f#"$state/world"}"; done
    sock=empire-$$ port=$((20000 + RANDOM % 20000)) sid=
    weston --backend=headless --socket="$sock" --width=1280 --height=820 >"$app/weston.log" 2>&1 &
    wpid=$!
    env -u DISPLAY WAYLAND_DISPLAY="$sock" GDK_BACKEND=wayland XDG_DATA_HOME="$app/data" \
      tauri-driver --port "$port" --native-port $((port + 1)) >"$app/driver.log" 2>&1 &
    dpid=$!
    wd() { curl -s "http://127.0.0.1:$port/session$1" -H 'content-type: application/json' "${@:2}"; }
    finish() {
      [[ -z $sid ]] || wd "/$sid" -X DELETE >/dev/null || true
      kill "$dpid" "$wpid" 2>/dev/null || true
      wait "$dpid" "$wpid" 2>/dev/null || true
    }
    trap finish EXIT
    for ((i = 0; i < 100; i++)); do
      [[ -S $XDG_RUNTIME_DIR/$sock ]] && curl -sf "http://127.0.0.1:$port/status" >/dev/null && break
      sleep 0.1
    done
    sid=$(wd "" -d "$(jq -nc --arg app "$bin" '{capabilities: {alwaysMatch: {"tauri:options": {application: $app}}}}')" |
      jq -r '.value.sessionId // empty') || true
    [[ -n $sid ]] || fail "the app did not start under WebDriver" "Read $app/driver.log and $app/weston.log, then retry"
    el() { wd "/$sid/element" -d "$(jq -nc --arg x "$1" '{using: "xpath", value: $x}')" | jq -r '.value["element-6066-11e4-a52e-4f735466cecf"] // empty'; }
    # React can drop a click made during a render, so click until the screen shows the result.
    press() {
      local e
      for ((i = 0; i < 100; i++)); do
        [[ -n $(el "$2") ]] && return
        e=$([[ -z $1 ]] || el "$1")
        [[ -z $e ]] || wd "/$sid/element/$e/click" -d '{}' >/dev/null
        sleep 0.2
      done
      e=$(el '//*[contains(@class, "error")]')
      fail "the app never showed $2${e:+: $(wd "/$sid/element/$e/text" | jq -r .value)}" "Read $app/driver.log"
    }
    on="//nav/button[normalize-space()=\"$view\"]"
    press '//nav[@class="rail"]/button[contains(., "Saved")]' '//ul[@class="worlds"]/li[span="verify"]'
    press '//ul[@class="worlds"]/li[span="verify"]/button' '//header[@class="bar"]'
    [[ -n $(el "$on") ]] || fail "the app has no view '$view'" "Choose one of: $(wd "/$sid/execute/sync" \
      -d '{"script": "return [...document.querySelectorAll(\"nav button\")].map((b) => b.textContent).join(\", \")", "args": []}' | jq -r .value)"
    press "$on" "${on}[contains(concat(' ', @class, ' '), ' on ')]"
    press '' '//main[not(.//*[contains(@class, "busy")])]'
    mkdir -p "$(dirname "$out")"
    wd "/$sid/screenshot" | jq -er .value | base64 -d >"$out" || fail "the screenshot failed" "Read $app/driver.log"
    jq -cn --arg view "$view" --arg out "$out" '{status: "captured", view: $view, out: $out}'
    ;;
  *) fail "unknown command: ${cmd:-<empty>}" "Run scripts/empire --help" ;;
esac
