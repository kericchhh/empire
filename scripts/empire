#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/empire <command> [arguments]

Commands:
  start [--scenario FILE] [--seed N] [--tick-seconds N]  Start a throwaway headless world
  doctor                             Check the running world, MCP and admin API
  tool <seat> <name> <json>          Call an MCP tool as a seat
  tick [n]                           Force-close n ticks (default 1)
  chronicle                          Print the current chronicle
  views                              Print every seat's look view
  stop                               Stop this CLI's world and remove its state
  --help                             Show this help

Set EMPIRE_STATE_DIR to choose the state directory. The default is a private
temporary directory, removed by stop.
EOF
}

fail() { jq -cn --arg error "$1" --arg next "$2" '{error:$error,next:$next}' >&2; exit 2; }
state=${EMPIRE_STATE_DIR:-/tmp/empire-control-$UID}
api() { printf 'http://127.0.0.1:%s' "$(cat "$state/port")"; }
admin_header() { printf 'Authorization: Bearer %s' "$(cat "$state/admin")"; }
mcp() {
  curl -sf "$(api)/mcp" -H 'content-type: application/json' \
    -H 'accept: application/json, text/event-stream' "$@"
}
call_tool() {
  local name=$1 args=$2 token session request
  token=$(jq -er --arg seat "$3" '.[$seat]' "$state/seats.json") || fail "unknown seat '$3'" "Run scripts/empire views and choose one of: $(jq -r 'keys | join(", ")' "$state/seats.json")"
  session=$(mcp -D - -o /dev/null -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"empire-control","version":"1"}}}' | tr -d '\r' | sed -n 's/^mcp-session-id: //Ip') || fail "MCP did not answer" "Run scripts/empire doctor; if needed, restart with scripts/empire stop && scripts/empire start"
  [ -n "$session" ] || fail "MCP returned no session" "Run scripts/empire doctor and check the world's server log"
  mcp -H "mcp-session-id: $session" -o /dev/null -d '{"jsonrpc":"2.0","method":"notifications/initialized"}' >/dev/null
  request=$(jq -nc --arg name "$name" --argjson args "$args" --arg token "$token" '{jsonrpc:"2.0",id:2,method:"tools/call",params:{name:$name,arguments:($args + {seat_token:$token})}}')
  mcp -H "mcp-session-id: $session" -d "$request" |
    sed -n 's/^data: //p' | jq '.result.structuredContent // .result // .error'
}

cmd=${1:-}
case "$cmd" in
  --help|-h|help) usage ;;
  start)
    shift
    scenario=scenarios/rome.yaml seed=2026 tick_seconds=86400
    while (($#)); do
      case "$1" in
        --scenario) (($# >= 2)) || fail "--scenario needs a file" "Use scripts/empire start --scenario scenarios/rome.yaml"; scenario=$2; shift 2 ;;
        --seed) (($# >= 2)) || fail "--seed needs a number" "Use scripts/empire start --seed 2026"; [[ $2 =~ ^[0-9]+$ ]] || fail "seed must be a non-negative integer" "Use scripts/empire start --seed 2026"; seed=$2; shift 2 ;;
        --tick-seconds) (($# >= 2)) || fail "--tick-seconds needs a number" "Use scripts/empire start --tick-seconds 2"; [[ $2 =~ ^[1-9][0-9]*$ ]] || fail "tick duration must be a positive integer" "Use scripts/empire start --tick-seconds 2"; tick_seconds=$2; shift 2 ;;
        *) fail "unknown start option: $1" "Run scripts/empire --help" ;;
      esac
    done
    [[ -f $scenario ]] || fail "scenario file not found: $scenario" "Choose a scenario such as scenarios/rome.yaml"
    command -v jq >/dev/null && command -v curl >/dev/null || fail "scripts/empire requires curl and jq" "Install curl and jq, then retry"
    [[ ! -e $state ]] || fail "state directory already exists: $state" "Run scripts/empire doctor; stop its world with scripts/empire stop before starting another"
    cargo build -q -p sim-server || fail "could not build sim-server" "Fix the cargo build error, then retry"
    mkdir -m 700 "$state"
    port=$((20000 + RANDOM % 20000)); printf '%s\n' "$port" >"$state/port"
    if command -v setsid >/dev/null 2>&1; then
      setsid target/debug/sim-server run --db "$state/world.db" --scenario "$scenario" --seed "$seed" --bind "127.0.0.1:$port" --tick-seconds "$tick_seconds" >"$state/out" 2>"$state/log" </dev/null &
    else
      nohup target/debug/sim-server run --db "$state/world.db" --scenario "$scenario" --seed "$seed" --bind "127.0.0.1:$port" --tick-seconds "$tick_seconds" >"$state/out" 2>"$state/log" </dev/null &
    fi
    echo $! >"$state/pid"
    ready=false
    for _ in $(seq 101); do
      if grep -q '^Seat tokens:' "$state/out" && curl -s -o /dev/null "$(api)/mcp"; then ready=true; break; fi
      if ! kill -0 "$(cat "$state/pid")" 2>/dev/null; then cat "$state/log" >&2; rm -rf "$state"; fail "world failed to start" "Check cargo output and scenario, then retry scripts/empire start"; fi
      sleep 0.1
    done
    if [[ $ready != true ]]; then kill "$(cat "$state/pid")" 2>/dev/null || true; cat "$state/log" >&2; rm -rf "$state"; fail "world did not answer in 10 seconds" "Check cargo output and scenario, then retry scripts/empire start"; fi
    admin=$(sed -n 's/^Admin token (for \/api): //p' "$state/out")
    [[ -n $admin ]] || fail "world did not provide an admin token" "Check the world log and retry scripts/empire start"
    printf '%s' "$admin" >"$state/admin"; chmod 600 "$state/admin"
    sed -n '/^Seat tokens:/,/^$/p' "$state/out" | tail -n +2 | awk 'NF >= 2 {print $1, $2}' | jq -Rn '[inputs | split(" ") | {(.[0]):.[1]}] | add // {}' >"$state/seats.json"
    chmod 600 "$state/seats.json"
    jq -cn --arg url "$(api)/mcp" --arg state "$state" --argjson seats "$(jq 'keys' "$state/seats.json")" '{status:"started",mcp:$url,state_dir:$state,seats:$seats}'
    ;;
  doctor)
    [[ -f $state/pid ]] || fail "no Empire world is recorded" "Start one with scripts/empire start"
    pid=$(cat "$state/pid")
    kill -0 "$pid" 2>/dev/null || fail "the recorded world process is not running" "Remove stale state with rm -rf '$state', then run scripts/empire start"
    mcp -o /dev/null -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"doctor","version":"1"}}}' >/dev/null || fail "world is up but MCP did not answer" "Check '$state/log'; restart with scripts/empire stop && scripts/empire start"
    overview=$(curl -sf -H "$(admin_header)" "$(api)/api/overview") || fail "MCP answered but the admin token failed" "Check '$state/admin'; restart with scripts/empire stop && scripts/empire start"
    jq -cn --argjson overview "$overview" '{status:"healthy",mcp:"answered",admin:"authorized",tick:$overview.state.tick}'
    ;;
  tool)
    (($# == 4)) || fail "tool needs a seat, tool name and JSON object" "Example: scripts/empire tool princeps look '{}'"
    jq -e 'type == "object"' <<<"$4" >/dev/null || fail "tool arguments must be a JSON object" "Pass '{}' or another JSON object as the fourth argument"
    [[ -f $state/seats.json ]] || fail "no Empire world is recorded" "Start one with scripts/empire start"
    call_tool "$3" "$4" "$2"
    ;;
  tick)
    n=${2:-1}; [[ $n =~ ^[1-9][0-9]*$ ]] || fail "tick count must be a positive integer" "Use scripts/empire tick 1"
    [[ -f $state/admin ]] || fail "no Empire world is recorded" "Start one with scripts/empire start"
    for ((i=0; i<n; i++)); do curl -sf -X POST -H "$(admin_header)" "$(api)/api/tick"; done | jq -s '{closed:map(.tick)}'
    ;;
  chronicle)
    [[ -f $state/admin ]] || fail "no Empire world is recorded" "Start one with scripts/empire start"
    curl -sf -H "$(admin_header)" "$(api)/api/overview" | jq '{tick:.state.tick,date,chronicle}'
    ;;
  views)
    [[ -f $state/seats.json ]] || fail "no Empire world is recorded" "Start one with scripts/empire start"
    jq -r 'keys[]' "$state/seats.json" | while read -r seat; do jq -cn --arg seat "$seat" --argjson view "$(call_tool look '{}' "$seat")" '{seat:$seat,view:$view}'; done | jq -s .
    ;;
  stop)
    [[ -f $state/pid ]] || { jq -cn '{status:"stopped",detail:"no state to clean"}'; exit 0; }
    pid=$(cat "$state/pid"); db="$state/world.db"
    if kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o command= | grep -Fq "$db"; then
      kill "$pid"
      for _ in $(seq 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
      if kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o command= | grep -Fq "$db"; then kill -KILL "$pid"; fi
    fi
    rm -rf "$state"
    jq -cn '{status:"stopped",state_removed:true}'
    ;;
  *) usage >&2; fail "unknown command: ${cmd:-<empty>}" "Run scripts/empire --help" ;;
esac
